pipeline {

    agent any

    tools {
        maven 'maven'
    }

    environment {
        IMAGE_NAME = 'maven-web-application'
        NEXUS_REGISTRY = 'host.docker.internal:7005'
        NEXUS_CREDENTIALS = 'nexus-credentials'
    }

    stages {

        stage('Git Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Maven Build') {
            steps {
                sh '''
                    mvn clean package
                '''
            }
        }

        stage('SonarQube Scan') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh '''
                        mvn sonar:sonar \
                        -Dsonar.projectKey=testing \
                        -Dsonar.projectName=testing
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    docker build \
                    -t ${IMAGE_NAME}:${BUILD_NUMBER} .
                '''
            }
        }

        stage('Docker Tag') {
            steps {
                sh '''
                    docker tag \
                    ${IMAGE_NAME}:${BUILD_NUMBER} \
                    ${NEXUS_REGISTRY}/${IMAGE_NAME}:${BUILD_NUMBER}

                    docker tag \
                    ${IMAGE_NAME}:${BUILD_NUMBER} \
                    ${NEXUS_REGISTRY}/${IMAGE_NAME}:latest
                '''
            }
        }

        stage('Nexus Login') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "${NEXUS_CREDENTIALS}",
                        usernameVariable: 'NEXUS_USERNAME',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        echo "$NEXUS_PASSWORD" | \
                        docker login ${NEXUS_REGISTRY} \
                        -u "$NEXUS_USERNAME" \
                        --password-stdin
                    '''
                }
            }
        }

        stage('Push to Nexus') {
            steps {
                sh '''
                    docker push \
                    ${NEXUS_REGISTRY}/${IMAGE_NAME}:${BUILD_NUMBER}

                    docker push \
                    ${NEXUS_REGISTRY}/${IMAGE_NAME}:latest
                '''
            }
        }
    }

    post {

        success {
            echo '================================='
            echo 'Pipeline SUCCESS'
            echo "Image: ${NEXUS_REGISTRY}/${IMAGE_NAME}:${BUILD_NUMBER}"
            echo '================================='
        }

        failure {
            echo 'Pipeline FAILED'
        }

        always {
            sh 'docker logout ${NEXUS_REGISTRY} || true'
        }
    }
}
